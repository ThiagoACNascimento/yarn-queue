generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PRODUCER
  ADMIN
}

enum ProductType {
  DEMAND
  STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FINISHED
}

model User {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  email String @db.VarChar(254) @unique 
  password String @db.VarChar(72) 
  active Boolean @db.Boolean @default(false)
  role Role @default(CUSTOMER)
  created_at DateTime @db.Timestamptz() @default(now())
  updated_at DateTime @db.Timestamptz() @updatedAt
  deleted_at DateTime? @db.Timestamptz() 
  expired_delete DateTime? @db.Timestamptz()
  orders Order []
}

model Product {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  price Decimal @db.Decimal(10, 2) 
  type ProductType @default(DEMAND)
  quantity Int?
  created_at DateTime @db.Timestamptz() @default(now())
  updated_at DateTime @db.Timestamptz() @updatedAt
  deleted_at DateTime? @db.Timestamptz() 
  orders_products OrderProduct []
}

model Order {
  id String @id @default(uuid())
  status OrderStatus @default(PENDING)
  user User @relation(fields: [userId], references: [id])
  userId String
  created_at DateTime @db.Timestamptz() @default(now())
  orders_products OrderProduct []
}

model OrderProduct {
  id String @id @default(uuid())
  order Order @relation(fields: [orderId], references: [id]) 
  orderId String 
  product Product @relation(fields: [productId], references: [id])
  productId String 
  quantity Int
  unit_price Decimal @db.Decimal(10, 2)
}