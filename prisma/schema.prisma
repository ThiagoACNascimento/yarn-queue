generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PRODUCER
  ADMIN
}

enum ProductType {
  DEMAND
  STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FINISHED
}

model User {
  // add db.Uuid()
  id String @id @default(uuid())
  name String @db.VarChar(100)
  email String @db.VarChar(254) @unique 
  password_hash String @db.VarChar(72) 
  active Boolean @db.Boolean @default(false)
  role Role @default(CUSTOMER)
  created_at DateTime @db.Timestamptz() @default(now())
  updated_at DateTime @db.Timestamptz() @updatedAt
  deleted_at DateTime? @db.Timestamptz() 
  expired_delete DateTime? @db.Timestamptz()
  orders Order []
  refresh_tokens RefreshToken[]

  @@map("users")
}

model Product {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  price Decimal @db.Decimal(10, 2) 
  type ProductType @default(DEMAND)
  quantity Int?
  created_at DateTime @db.Timestamptz() @default(now())
  updated_at DateTime @db.Timestamptz() @updatedAt
  deleted_at DateTime? @db.Timestamptz() 
  orders_products OrderProduct[]

  @@map("products")
}

model Order {
  id String @id @default(uuid())
  status OrderStatus @default(PENDING)
  user_id String
  created_at DateTime @db.Timestamptz() @default(now())
  orders_products OrderProduct[]

  user User @relation(fields: [user_id], references: [id])

  @@map("orders")
}

model OrderProduct {
  id String @id @default(uuid())
  order_id String 
  product_id String 
  quantity Int
  unit_price Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [order_id], references: [id]) 
  product Product @relation(fields: [product_id], references: [id])

  @@map("order_products")
}

model RefreshToken {
  id String @id @default(uuid())
  user_id String
  token_hash String @unique @db.VarChar(255)
  user_agent String? @db.VarChar(500)
  ip_address String? @db.VarChar(45)
  created_at DateTime @db.Timestamptz() @default(now())
  expires_at DateTime @db.Timestamptz()
  last_used_at DateTime? @db.Timestamptz()
  revoked_at DateTime? @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@map("refresh_tokens")
}